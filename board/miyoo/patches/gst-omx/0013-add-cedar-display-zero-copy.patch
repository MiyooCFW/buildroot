+    }
+
+    if (!self->out_port_pool) {
+      err = gst_omx_video_dec_allocate_output_buffers (self);
+      if (err != OMX_ErrorNone) {
+        if (buf) {
+          gst_omx_port_release_buffer (port, buf);
+          buf = NULL;
+        }
+        goto reconfigure_error;
+      }
     }
 
