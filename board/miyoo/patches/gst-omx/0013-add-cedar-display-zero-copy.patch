  *   Author: Sebastian Dröge <sebastian.droege@collabora.co.uk>, Collabora Ltd.
@@ -97,6 +98,25 @@
 G_DEFINE_ABSTRACT_TYPE_WITH_CODE (GstOMXVideoDec, gst_omx_video_dec,
     GST_TYPE_VIDEO_DECODER, DEBUG_INIT);
 
+/* Serialized with downstream buffers, including any queue. The sink stops
+ * DEFE before releasing the last displayed OMX buffer. */
+static void
+cedar_release_display (GstOMXVideoDec *self)
+{
+  gst_pad_push_event (GST_VIDEO_DECODER_SRC_PAD (self),
+        gst_event_new_custom (GST_EVENT_CUSTOM_DOWNSTREAM,
+            gst_structure_new_empty (CEDAR_DISPLAY_RELEASE_EVENT)));
+}
+
+static void
+cedar_output_caps (GstOMXVideoDec *self, GstVideoCodecState *state)
+{
+  gst_caps_replace (&state->caps, NULL);
+  state->caps = gst_video_info_to_caps (&state->info);
+  gst_caps_set_features (state->caps, 0,
+      gst_caps_features_new (CEDAR_DISPLAY_FEATURE, NULL));
+}
