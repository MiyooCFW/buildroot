 static OMX_ERRORTYPE
 gst_omx_video_dec_deallocate_output_buffers (GstOMXVideoDec * self)
 {
   OMX_ERRORTYPE err;
+
+  if (self->out_port_pool) {
+    /* The stock pool teardown does not wait for downstream users. Never free
+     * OMX descriptors while a sink/queue still owns a picture lease. */
+    err = gst_omx_port_wait_buffers_released (self->dec_out_port, 5 * GST_SECOND);
+    if (err != OMX_ErrorNone)
+      return err;
+  }
 
   if (self->out_port_pool) {
     gst_buffer_pool_set_active (self->out_port_pool, FALSE);
@@ -1139,6 +887,7 @@
   state = gst_video_decoder_set_output_state (GST_VIDEO_DECODER (self),
       format, port_def.format.video.nFrameWidth,
       port_def.format.video.nFrameHeight, self->input_state);
+  cedar_output_caps (self, state);
 
   if (!gst_video_decoder_negotiate (GST_VIDEO_DECODER (self))) {
     gst_video_codec_state_unref (state);
@@ -1280,6 +1029,7 @@
     /* Reallocate all buffers */
     if (acq_return == GST_OMX_ACQUIRE_BUFFER_RECONFIGURE
         && gst_omx_port_is_enabled (port)) {
