+/* Called only while awMutexHandler is held. Output allocations outlive
+ * Executing -> Idle, so defer decoder destruction until the last lease ends. */
+static void cedarRelease(OmxAwDecoderContext *ctx, CedarOutput *out)
+{
+    if (!out || !out->picture)
+        return;
+    ReturnPicture(ctx->m_decoder, out->picture);
+    out->picture = NULL;
+    out->frame.magic = 0;
+    ctx->cedarPictures--;
+    if (ctx->cedarClosePending && !ctx->cedarPictures) {
+        DestroyVideoDecoder(ctx->m_decoder);
+        ctx->m_decoder = NULL;
+        ctx->cedarClosePending = OMX_FALSE;
+    }
+    OmxTryPostSem(ctx->mSemOutBuffer);
+}
+
+static int cedarDescribe(OmxAwDecoderContext *ctx, VideoPicture *pic,
+                         struct cedar_display_frame *f)
+{
+    char *planes[3] = {pic->pData0, pic->pData1, pic->pData2};
+    unsigned int i, count;
+    memset(f, 0, sizeof(*f));
+    if (pic->nWidth <= 0 || pic->nHeight <= 0 || pic->nLineStride <= 0 ||
+        pic->nWidth > 2048 || pic->nHeight > 2048 || !pic->bIsProgressive ||
+        pic->b10BitPicFlag || pic->bEnableAfbcFlag)
+        return -1;
+    f->version = CEDAR_DISPLAY_VERSION;
+    f->width = pic->nWidth;
+    f->height = pic->nHeight;
+    f->crop_x = pic->nLeftOffset;
+    f->crop_y = pic->nTopOffset;
+    f->crop_width = pic->nRightOffset - pic->nLeftOffset;
+    f->crop_height = pic->nBottomOffset - pic->nTopOffset;
+    if (pic->nRightOffset <= pic->nLeftOffset ||
+        pic->nBottomOffset <= pic->nTopOffset) {
+        f->crop_x = f->crop_y = 0;
+        f->crop_width = f->width;
+        f->crop_height = f->height;
+    }
+    if (f->crop_x > f->width || f->crop_y > f->height ||
+        f->crop_width > f->width - f->crop_x ||
+        f->crop_height > f->height - f->crop_y ||
+        ((f->crop_x | f->crop_y | f->crop_width | f->crop_height) & 1))
+        return -1;
+    f->stride[0] = pic->nLineStride;
+    if (pic->ePixelFormat == PIXEL_FORMAT_YUV_MB32_420) {
+        f->format = CEDAR_DISPLAY_MB32_NV12;
+        f->stride[1] = f->stride[0];
+        count = 2;
+        if ((f->stride[0] & 31) || !planes[1])
+            return -1;
+    } else if (pic->ePixelFormat == PIXEL_FORMAT_YV12) {
+        f->format = CEDAR_DISPLAY_YUV420P;
+        f->stride[1] = f->stride[2] = f->stride[0] / 2;
+        /* Use the allocator's actual plane bases, including its padding. */
+        if (!pic->pData1 || !pic->pData2)
+            return -1;
+        planes[1] = pic->pData2; /* U */
+        planes[2] = pic->pData1; /* V */
+        count = 3;
+    } else {
+        return -1; /* Never relabel tiled or unsupported pixels as linear. */
+    }
+    for (i = 0; i < count; i++) {
+        uintptr_t addr;
+        if (!planes[i])
+            return -1;
+        addr = (uintptr_t)CdcMemGetPhysicAddressCpu(ctx->decMemOps, planes[i]);
+        if (!addr || addr > UINT32_MAX)
+            return -1;
+        f->addr[i] = addr;
+    }
+    f->magic = CEDAR_DISPLAY_MAGIC;
+    return 0;
+}
 
