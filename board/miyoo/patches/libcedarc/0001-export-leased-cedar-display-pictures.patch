+/* SPDX-License-Identifier: MIT
+ * Private, versioned Cedar -> GStreamer -> F1C100s /dev/disp ABI.
+ * Addresses are CPU physical DRAM addresses, not VE-relative addresses.
+ * A frame remains owned by its OMX output buffer until that buffer is returned.
+ */
+#ifndef CEDAR_DISPLAY_H
+#define CEDAR_DISPLAY_H
+
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+#define CEDAR_DISPLAY_VERSION 1
+#define CEDAR_DISPLAY_MAGIC 0x43445231U
+#define CEDAR_DISPLAY_FEATURE "memory:CedarPicture"
+#define CEDAR_DISPLAY_RELEASE_EVENT "cedar-display-release"
+#define CEDAR_OMX_ENABLE_INDEX 0x7fcd0001U
+#define CEDAR_OMX_RELEASE_INDEX 0x7fcd0002U
+#define CEDAR_OMX_EXTENSION "OMX.allwinner.index.param.cedarDisplay"
+
+#define CEDAR_DISPLAY_YUV420P 1U /* addr: Y, U, V */
+#define CEDAR_DISPLAY_MB32_NV12 2U /* addr: Y, interleaved UV, unused */
+
+struct cedar_display_frame {
+    __u32 magic;
+    __u32 version;
+    __u32 format;
+    __u32 addr[3];
+    __u32 stride[3]; /* bytes per row before MB32 encoding */
+    __u32 width;     /* allocated luma dimensions */
+    __u32 height;
+    __u32 crop_x;
+    __u32 crop_y;
+    __u32 crop_width;
+    __u32 crop_height;
+    __u32 reserved;
+};
+
+/* New ioctls deliberately do not overlap the legacy sunxi DISP ABI.
+ * PRESENT waits for a register load and a following output-line boundary.
+ * Success permits releasing the PREVIOUS frame; the submitted frame remains
+ * in use until the next successful PRESENT or STOP.
+ * On PRESENT error keep both frames until STOP succeeds.
+ */
+#define CEDAR_DISP_GET_VERSION _IOR('C', 0x70, __u32)
+#define CEDAR_DISP_PRESENT _IOW('C', 0x71, struct cedar_display_frame)
+#define CEDAR_DISP_STOP _IO('C', 0x72)
+
+#endif
